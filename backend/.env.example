# ISA — Environment Configuration Template
# Copy to .env and fill in. NEVER commit real secrets to git.

# ── Application ────────────────────────────────────────────────────────────────
# APP_NAME=IASA
# VERSION=0.1.0
# ENVIRONMENT=development   # development | staging | production

# ── Server ──────────────────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database (PostgreSQL) ───────────────────────────────────────────────────────
# DATABASE_URL=postgresql://isa_user:DB_PASSWORD@localhost:5432/isa_db
# Create the database and user before first run:
#   createdb isa_db
#   psql -c "CREATE USER isa_user WITH PASSWORD 'DB_PASSWORD';"
#   psql -c "GRANT ALL PRIVILEGES ON DATABASE isa_db TO isa_user;"

# ── Redis ───────────────────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ── JWT Authentication ──────────────────────────────────────────────────────────
# JWT_SECRET=CHANGE-ME-IN-PRODUCTION-USE-A-32-CHAR-RANDOM-STRING
# JWT_ALGORITHM=HS256
# JWT_TOKEN_EXPIRE_MINUTES=60
# JWT_REFRESH_EXPIRE_DAYS=7

# ── LLM Provider (adapter-backed; change provider without rewriting orchestration) ─
# LLM_PROVIDER=openai          # openai | anthropic | local-ollama
# LLM_API_BASE=https://api.openai.com/v1
# LLM_API_KEY=OPENAI_API_KEY
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_TOKENS=4096

# ── Campus Guardian connector ───────────────────────────────────────────────────
# CG_API_BASE_URL=http://localhost:8000
# CG_API_KEY=CG_API_KEY_HERE   # Campus Guardian X-API-Key

# ── F.R.I.D.A.Y hub connector ───────────────────────────────────────────────────
# FRIDAY_HUB_WS_URL=ws://localhost:8765
# FRIDAY_HUB_SESSION_KEY=HUB_SESSION_KEY_HERE   # must match hub SESSION_KEY
# FRIDAY_HUB_HTTP2_URL=http://localhost:8766
